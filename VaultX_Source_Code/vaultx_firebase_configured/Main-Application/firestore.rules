rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validPortfolio() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'description', 'createdAt'])
        && d.keys().hasAll(['name', 'description', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 400
        && d.createdAt == request.time;
    }
    match /users/{uid}/portfolios/{portfolioId} {
      allow get, list: if owner(uid);
      allow create: if owner(uid) && validPortfolio();
      allow delete: if owner(uid);
      allow update: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
